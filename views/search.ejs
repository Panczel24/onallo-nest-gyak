<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Keresés</title>
</head>
<body>
    <a href="/" >Főoldal</a>


    <form action="/search" method="GET">

        <input type="text" name="keresett">

        <button type="submit">Keresés</button>

    </form>


    <% if (talalatok.length === 0) { %>

        <p>Nincs találat.</p>

    <% } else { %>

        <h2>Találatok:</h2>

        <ul>
            <% talalatok.forEach((talalat) => { %>
                <li><%= talalat %></li>
            <% }) %>
        </ul>

    <% } %>

</body>
</html>